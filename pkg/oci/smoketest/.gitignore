# Transient build artifacts the run-pod-*.sh drivers stage into this directory and remove
# again on exit. They are listed here so an interrupted run cannot leave a multi-megabyte
# binary or a whole SDK tree looking like tracked changes.

# Cross-compiled demo programs (run-pod-*.sh build these before the image build).
program-linux

# This branch's Node SDK, staged into program build contexts by run-pod-node-transform.sh,
# run-pod-dynamic.sh, run-pod-policy.sh, and run-host-engine-mlc.sh.
program-node-transform/sdk-bin/
program-node-dynamic/sdk-bin/
component-greeter/sdk-bin/

# The bind-contract @pulumi/policy, staged by run-pod-policy.sh from a pulumi-policy clone.
policy-pack-node/policy-sdk-bin/

# This branch's Python SDK + the CLI's exec shim, staged by run-pod-python-transform.sh.
program-python-transform/sdk-lib/
program-python-transform/pulumi-language-python-exec
