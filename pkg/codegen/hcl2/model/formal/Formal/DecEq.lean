import Formal.Types

/-!
Decidable equality for `Ty`. Lean cannot derive `DecidableEq` for a nested
inductive type, so this file spells it out. Nothing here is part of the rules.
-/

namespace Formal

mutual
def Ty.decEq : (a b : Ty) → Decidable (a = b)
  | .bool, .bool => isTrue rfl
  | .int, .int => isTrue rfl
  | .number, .number => isTrue rfl
  | .string, .string => isTrue rfl
  | .id, .id => isTrue rfl
  | .dynamic, .dynamic => isTrue rfl
  | .none, .none => isTrue rfl
  | .const v, .const w =>
    match decEq v w with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .enum t b vs, .enum t' b' vs' =>
    match decEq t t', Ty.decEq b b', decEq vs vs' with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by rw [h0, h1, h2])
    | isFalse h0, _, _ => isFalse (by intro e; cases e; exact h0 rfl)
    | _, isFalse h1, _ => isFalse (by intro e; cases e; exact h1 rfl)
    | _, _, isFalse h2 => isFalse (by intro e; cases e; exact h2 rfl)
  | .list a, .list b =>
    match Ty.decEq a b with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .set a, .set b =>
    match Ty.decEq a b with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .map a, .map b =>
    match Ty.decEq a b with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .tuple as, .tuple bs =>
    match decEqList as bs with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .object as, .object bs =>
    match decEqProps as bs with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .union as, .union bs =>
    match decEqList as bs with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .output a, .output b =>
    match Ty.decEq a b with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .promise a, .promise b =>
    match Ty.decEq a b with
    | isTrue h => isTrue (by rw [h])
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | .bool, .int => isFalse nofun
