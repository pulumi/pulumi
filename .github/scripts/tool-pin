#!/usr/bin/env bash
# Copyright 2026, Pulumi Corporation.
#
# Prints a [tools] or [vars] pin from .mise.toml, the parser every CI
# consumer shares. Fails on a missing or duplicated key so format drift
# breaks loudly. Deliberately never reads mise.dev.toml, which CI does
# not consume.
#
# Usage:
#   tool-pin gradle                    ([tools])
#   tool-pin github:pulumi/goteststats ([tools])
#   tool-pin yarn                      ([vars])
#   tool-pin npm                       (the [vars] npm range)
set -euo pipefail
cd "$(dirname "$0")/../.."

KEY="${1:?usage: $0 <mise-key>}"
# Only [tools] and [vars]: other sections reuse key names for non-pins
# (gradle in [plugins]). Accepts both TOML quote styles. A `.` in keys
# matches any character, harmless under the full-line anchors.
v=$(awk '/^\[/ { insec = ($0 == "[tools]" || $0 == "[vars]"); next } insec' .mise.toml \
  | sed -n \
      -e "s|^\"\{0,1\}${KEY}\"\{0,1\} = \"\(.*\)\"\$|\1|p" \
      -e "s|^\"\{0,1\}${KEY}\"\{0,1\} = '\(.*\)'\$|\1|p")
case "$v" in
  "")
    echo "FATAL: no pin for '${KEY}' parsed from .mise.toml (format change?)" >&2
    exit 1
    ;;
  *$'\n'*)
    echo "FATAL: multiple pins for '${KEY}' in .mise.toml" >&2
    exit 1
    ;;
esac
printf '%s\n' "$v"
