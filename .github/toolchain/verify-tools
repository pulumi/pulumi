#!/usr/bin/env bash
# Copyright 2026, Pulumi Corporation.
#
# Pre-push gate for ci-toolchain-image.yml: runs a built image and
# asserts every tool is at its expected version and that mise did not
# survive into the runtime image. Also runnable locally.
#
# Usage: verify-tools <image-ref> <version-set-name>
set -euo pipefail
cd "$(dirname "$0")/../.."

IMAGE="${1:?usage: $0 <image-ref> <version-set-name>}"
SET="${2:?usage: $0 <image-ref> <version-set-name>}"

# Plain assignments so a failed tool-pin lookup aborts under `set -e`.
PIN=./.github/scripts/tool-pin
DLV_PIN=$($PIN dlv)
UV_PIN=$($PIN uv)
BUN_PIN=$($PIN bun)
YARN_PIN=$($PIN yarn)
PNPM_PIN=$($PIN pnpm)
GRADLE_PIN=$($PIN gradle)
GOTESTSUM_PIN=$($PIN gotestsum)
JAVA_PIN=$($PIN java)
JAVA_MAJOR=${JAVA_PIN#*-} # e.g. temurin-11 -> 11

# The image keeps node's bundled npm, so assert it satisfies the
# cooldown floor from the npm pin (e.g. ^11.17.0 -> 11.17.0). Below the
# floor, npm silently ignores the cooldown settings.
NPM_FLOOR=$($PIN npm)
NPM_FLOOR=${NPM_FLOOR#^}
if ! echo "$NPM_FLOOR" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "FATAL: could not derive the npm floor from '$($PIN npm)'" >&2
  exit 1
fi

# The same language-version authority the image build used.
VERSION_SET=$(./scripts/get-job-matrix.py generate-version-set --version-set "$SET")
read -r GO_MINOR NODE_MAJOR PY_MINOR DOTNET_CHANNEL < <(printf '%s' "$VERSION_SET" | python3 -c '
import json, sys
d = json.load(sys.stdin)
def s(v):
    return v[:-2] if v.endswith(".x") else v
print(s(d["go"]), s(d["nodejs"]), s(d["python"]), d["dotnet"])
')

echo "== Verifying tools in ${IMAGE} (${SET}) =="
docker run --rm -i --platform linux/amd64 \
  -e "GO_MINOR=$GO_MINOR" -e "NODE_MAJOR=$NODE_MAJOR" \
  -e "PY_MINOR=$PY_MINOR" -e "DOTNET_CHANNEL=$DOTNET_CHANNEL" \
  -e "DLV_PIN=$DLV_PIN" \
  -e "UV_PIN=$UV_PIN" \
  -e "BUN_PIN=$BUN_PIN" \
  -e "YARN_PIN=$YARN_PIN" \
  -e "PNPM_PIN=$PNPM_PIN" \
  -e "GRADLE_PIN=$GRADLE_PIN" \
  -e "GOTESTSUM_PIN=$GOTESTSUM_PIN" \
  -e "NPM_FLOOR=$NPM_FLOOR" \
  -e "JAVA_MAJOR=$JAVA_MAJOR" \
  "$IMAGE" bash -s <<'EOF'
set -uo pipefail
fail=0
expect() { # expect <label> <expected-substring> <actual>
  if [[ "$3" == *"$2"* ]]; then
    echo "ok:   $1: $3 (contains '$2')"
  else
    echo "FAIL: $1: '$3' does not contain '$2'"; fail=1
  fi
}
present() { # tools with no version pin to assert
  if command -v "$1" >/dev/null; then
    echo "ok:   $1 present ($(command -v "$1"))"
  else
    echo "FAIL: $1 missing"; fail=1
  fi
}

expect go     "go${GO_MINOR}."      "$(go version)"
expect node   "v${NODE_MAJOR}."     "$(node --version)"
expect python "Python ${PY_MINOR}." "$(python --version)"
expect python3 "Python ${PY_MINOR}." "$(python3 --version)"
expect dotnet "${DOTNET_CHANNEL}."  "$(dotnet --version)"
expect java   "version \"${JAVA_MAJOR}" "$(java -version 2>&1 | head -1)"
expect gradle "Gradle ${GRADLE_PIN}" "$(gradle --version | grep Gradle)"
expect dlv    "${DLV_PIN}"          "$(dlv version | grep -i version)"
expect uv     "${UV_PIN}"           "$(uv --version)"
expect bun    "${BUN_PIN}"          "$(bun --version)"
expect yarn   "${YARN_PIN}"         "$(yarn --version)"
expect pnpm   "${PNPM_PIN}"         "$(pnpm --version)"
NPM_VERSION=$(npm --version)
if [ "$(printf '%s\n%s\n' "$NPM_FLOOR" "$NPM_VERSION" | sort -V | head -1)" = "$NPM_FLOOR" ]; then
  echo "ok:   npm: ${NPM_VERSION} (>= cooldown floor ${NPM_FLOOR})"
else
  echo "FAIL: npm: ${NPM_VERSION} is below the cooldown floor ${NPM_FLOOR}"; fail=1
fi
expect gotestsum "${GOTESTSUM_PIN}" "$(gotestsum --version)"
present goteststats
expect pip    "pip"                 "$(python -m pip --version)"
present pip
expect poetry "Poetry"              "$(poetry --version)"
for pkg in requests wheel urllib3 chardet build; do
  python -c "import $pkg" 2>/dev/null && echo "ok:   python package $pkg importable" \
    || { echo "FAIL: python package $pkg not importable"; fail=1; }
done
present gofmt; present npx; present uvx
present git; present make; present gcc; present jq; present curl
present tar; present unzip; present zip; present sudo
present gh; present gopls; present changie; present vale
present golangci-lint; present tsc; present typescript-language-server
present gow; present protoc; present protoc-gen-go; present protoc-gen-go-grpc
present grpc_tools_node_protoc; present protoc-gen-ts; present protoc-gen-js
present requiredfield; present wat2wasm
expect "git safe.directory" "*" "$(git config --system --get-all safe.directory)"

# Not root (tests rely on permission enforcement), and the uid must
# match the runner user that owns the mounts.
expect uid "1001" "$(id -u)"
if sudo -n true 2>/dev/null; then
  echo "ok:   passwordless sudo for $(id -un)"
else
  echo "FAIL: passwordless sudo unavailable"; fail=1
fi

# mise must not remain after build. With plain binaries on PATH there
# is no runtime resolution for a workspace config to sway.
if command -v mise >/dev/null; then
  echo "FAIL: mise binary present at runtime"; fail=1
else
  echo "ok:   mise binary absent"
fi
if [ -e /opt/mise/shims ]; then
  echo "FAIL: mise shims present at runtime"; fail=1
else
  echo "ok:   mise shims absent"
fi

exit $fail
EOF

echo "${IMAGE} tool verification PASSED"
